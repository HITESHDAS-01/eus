# ---------------------------------------------------------------------------
# Supabase configuration (REQUIRED)
# Get these from Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# ---------------------------------------------------------------------------
# Org-specific overrides (optional)
# Defaults live in src/config/branding.ts. Use these to override per-client
# without editing source. Currency code uses ISO-4217 (INR, USD, etc.).
# ---------------------------------------------------------------------------
# VITE_ORG_NAME="Ekota Unnayan Sanstha"
# VITE_ORG_SHORT="EUS"
# VITE_ORG_CURRENCY="INR"
